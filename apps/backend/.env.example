# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/kuchniapp
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kuchniapp
DB_USER=postgres
DB_PASSWORD=password

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# OpenAI
OPENAI_API_KEY=sk-...

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your-expo-access-token

# OpenFoodFacts (brak klucza — publiczne API)
OPENFOODFACTS_USER_AGENT=KuchniApp/1.0 (contact@kuchniapp.pl)
